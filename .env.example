# Required: generate a random value and provide it only to QA testers.
ASR_API_TOKEN=replace-with-a-long-random-token

# Point at an already-cached faster-whisper CTranslate2 model. This API never downloads weights.
ASR_MODEL_CACHE=/home/phongnth/asr-bestmodel/models/faster-whisper-large-v3/weights
# Optional exact snapshot path (takes precedence over ASR_MODEL_CACHE).
# ASR_MODEL_PATH=/path/to/models--Systran--faster-whisper-large-v3/snapshots/<revision>
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_MODEL_WORKERS=4
ASR_MAX_INFLIGHT=2
ASR_MAX_AUDIO_MB=100
ASR_QUEUE_TIMEOUT_S=60

# Comma-separated explicit origins and/or regex. Add the deployed Vercel QA URL.
ASR_ALLOWED_ORIGINS=https://your-qa-project.vercel.app
ASR_ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+(-[a-z0-9-]+)?\.vercel\.app$

# Keep the app private behind an HTTPS reverse proxy. Do not expose raw HTTP publicly.
ASR_HOST=127.0.0.1
ASR_PORT=8767
