# Required: generate a random value and provide it only to QA testers.
ASR_API_TOKEN=replace-with-a-long-random-token

# Local model cache. Keep downloaded model files out of Git; models/ is gitignored.
ASR_MODEL_CACHE=./models
# Optional exact snapshot path (takes precedence over ASR_MODEL_CACHE).
# ASR_MODEL_PATH=/path/to/models--Systran--faster-whisper-large-v3/snapshots/<revision>
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_MODEL_WORKERS=4
ASR_MAX_INFLIGHT=2
ASR_MAX_AUDIO_MB=100
ASR_QUEUE_TIMEOUT_S=60

# Comma-separated exact origins allowed to call this API from a browser.
ASR_ALLOWED_ORIGINS=http://127.0.0.1:8000
ASR_ALLOWED_ORIGIN_REGEX=

# Keep the app private behind an HTTPS reverse proxy. Do not expose raw HTTP publicly.
ASR_HOST=127.0.0.1
ASR_PORT=8767
